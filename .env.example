# Copy this file to `.env` only if you need explicit settings.
# The game automatically inherits the current pi provider (`PI_PROVIDER` / `PI_MODEL`)
# when those variables and `~/.pi/agent/models.json` are available.
# Explicit `.env` values override the inherited provider.
OPENAI_API_KEY=
SLAYTHETEXT_AI_EVENTS=1
SLAYTHETEXT_AI_MODEL=
# Optional OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
